AIONIS_EDITION=lite
AIONIS_MODE=local
APP_ENV=dev
AIONIS_LISTEN_HOST=127.0.0.1
MEMORY_AUTH_MODE=off
TENANT_QUOTA_ENABLED=false
RATE_LIMIT_BYPASS_LOOPBACK=true
LITE_REPLAY_SQLITE_PATH=.tmp/aionis-lite-replay.sqlite
LITE_WRITE_SQLITE_PATH=.tmp/aionis-lite-write.sqlite
LITE_LOCAL_ACTOR_ID=local-user
AIONIS_ADMISSION_CANDIDATE_POLICY_MODE=off
SANDBOX_ENABLED=false
SANDBOX_ADMIN_ONLY=true
# Default quickstart path uses OpenAI-compatible embeddings:
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=your-provider-key
# Optional OpenAI-compatible endpoint override, for example Moonshot/Kimi:
# OPENAI_EMBED_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_EMBEDDING_MODEL=your-embedding-model
# MiniMax embeddings use db vectors for stored memory and query vectors for recall by default:
# EMBEDDING_PROVIDER=minimax
# MINIMAX_API_KEY=your-provider-key
# MINIMAX_EMBED_DB_TYPE=db
# MINIMAX_EMBED_QUERY_TYPE=query
# Optional OpenAI-compatible governance/review model override:
# GOVERNANCE_MODEL_CLIENT_BASE_URL=https://api.moonshot.cn/v1
# GOVERNANCE_MODEL_CLIENT_API_KEY=your-provider-key
# GOVERNANCE_MODEL_CLIENT_MODEL=kimi-k2.6
# Optional recall ANN sidecar. Default off; ANN only generates candidates, governance still decides admission.
# Supported values: off | local | zvec
RECALL_ANN_PROVIDER=off
# RECALL_ZVEC_PATH=.aionis-zvec-ann
RECALL_ANN_REBUILD_ON_START=false
RECALL_ANN_MAX_CANDIDATES=200
# Optional validation-only local sandbox preset:
# LITE_SANDBOX_PROFILE=local_process_echo
# Only widen the bind host intentionally, for example behind a reverse proxy:
# AIONIS_LISTEN_HOST=0.0.0.0
# AIONIS_ALLOW_UNAUTHENTICATED_REMOTE=true
