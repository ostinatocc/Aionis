# Aionis Continuation Runtime V1 — Docker Compose input
#
# Copy this file to .env and fill the blank values required by the services you
# run. Compose passes an exact subset to each process. Never attach this whole
# file with `env_file:` or export it wholesale: daemon, provisioner, and worker
# environment allowlists intentionally differ and unknown AIONIS_* fields fail.

COMPOSE_PROJECT_NAME=aionis-v1
AIONIS_CONTAINER_IMAGE=aionis-continuation-runtime-v1:local

# Host publication. The daemon always listens on 0.0.0.0:3000 inside its
# container; keep the published host address on loopback unless a trusted
# reverse proxy supplies the outer network boundary.
HTTP_BIND=127.0.0.1
HTTP_PORT=3000

# One local authority database and tenant. Compose scopes the named volume to
# COMPOSE_PROJECT_NAME so independent projects do not silently share authority.
AIONIS_TENANT_ID=tenant-1

# Public Ed25519 authority root only. The file path is a host path mounted
# read-only; Runtime never accepts the authority-root private key.
TRUST_ROOT_PUBLIC_KEY_FILE=
AIONIS_TRUST_ROOT_SHA256=

# Strict daemon principals. Generate two different random tokens, each at least
# 32 bytes with no whitespace. Do not commit the populated .env file.
AIONIS_HOST_PRINCIPAL_ID=trusted-host-1
AIONIS_HOST_API_KEY=
AIONIS_OPERATOR_PRINCIPAL_ID=operator-1
AIONIS_OPERATOR_API_KEY=

# Bounded operational settings.
AIONIS_HTTP_BODY_LIMIT_BYTES=1048576
AIONIS_LOG_LEVEL=info
AIONIS_SHUTDOWN_TIMEOUT_MS=30000
AIONIS_JOB_POLL_MS=250
AIONIS_JOB_BATCH_SIZE=16
AIONIS_JOB_LEASE_MS=60000

# Embedding profile only. All four values are required when worker-embedding is
# enabled and are never passed to daemon, ann, effect, or retention processes.
AIONIS_EMBEDDING_BASE_URL=https://provider.example/v1
AIONIS_EMBEDDING_MODEL=
AIONIS_EMBEDDING_DIMENSIONS=
AIONIS_EMBEDDING_API_KEY=

# Effect profile only. The Compose deployment copy must be an unencrypted PKCS#8
# Ed25519 private key owned by the host ids mapped to container uid/gid 1000 and
# have exact mode 0400 or 0600. This key must be distinct from the authority root.
EFFECT_SIGNER_PRIVATE_KEY_FILE=
AIONIS_EFFECT_SIGNER_SHA256=

# Provision-cohort profile only. This regular host file must contain exactly 32
# raw bytes, have mode 0400 or 0600, and be owned by the host ids mapped to
# container uid/gid 1000. A root-owned private file is not readable by the
# non-root Compose process. The seed is inherited on fd 3 and never placed in
# environment or JSON.
COHORT_SEED_FILE=
