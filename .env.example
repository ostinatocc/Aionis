# Local core (default)
AIONIS_EDITION=lite
AIONIS_MODE=local
APP_ENV=dev
PORT=3001
AIONIS_LISTEN_HOST=127.0.0.1
LITE_REPLAY_SQLITE_PATH=.tmp/aionis-lite-replay.sqlite
LITE_WRITE_SQLITE_PATH=.tmp/aionis-lite-write.sqlite
LITE_LOCAL_ACTOR_ID=local-user
MEMORY_AUTH_MODE=off
TENANT_QUOTA_ENABLED=false
RATE_LIMIT_BYPASS_LOOPBACK=true
AIONIS_ADMISSION_CANDIDATE_POLICY_MODE=off
RUNTIME_VERIFIER_EXECUTION_ENABLED=false
SANDBOX_ENABLED=false
SANDBOX_ADMIN_ONLY=true

# Runtime starts without an embedding key. Enable one provider when semantic
# recall or embedding-backed validation is needed.
EMBEDDING_PROVIDER=none
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=your-provider-key
# OPENAI_EMBED_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_PROVIDER=minimax
# MINIMAX_API_KEY=your-provider-key
# MINIMAX_EMBED_DB_TYPE=db
# MINIMAX_EMBED_QUERY_TYPE=query

# Optional local Zvec candidate index. SQLite remains the truth store.
RECALL_ANN_PROVIDER=off
# RECALL_ANN_PROVIDER=zvec
# RECALL_ZVEC_PATH=.aionis-zvec-ann
# RECALL_ANN_REBUILD_ON_START=false
# RECALL_ANN_MAX_CANDIDATES=200

# Optional Substrate candidate sidecar. Runtime reloads candidates from SQLite
# before lifecycle, authority, admission, and rehydrate decisions.
# RECALL_SUBSTRATE_SIDECAR_ENABLED=true
# RECALL_SUBSTRATE_PATH=.aionis-substrate/substrate.sqlite
# RECALL_SUBSTRATE_MAX_CANDIDATES=200
# RECALL_SUBSTRATE_FAIL_OPEN=true

# Advanced: authenticated Server development or production.
# AIONIS_EDITION=server
# AIONIS_MODE=service
# APP_ENV=dev
# MEMORY_AUTH_MODE=api_key
# MEMORY_API_KEYS_JSON={"replace-with-api-key":{"tenant_id":"tenant-1","agent_id":"agent-1","role":"developer"}}
# TENANT_QUOTA_ENABLED=false
# RATE_LIMIT_BYPASS_LOOPBACK=true
#
# Production also requires fail-closed request controls and durable authority
# receipt signing keys. Generate secrets outside the repository.
# APP_ENV=prod
# TENANT_QUOTA_ENABLED=true
# RATE_LIMIT_BYPASS_LOOPBACK=false
# AIONIS_AUTHORITY_RECEIPT_HMAC_ACTIVE_KEY_ID=authority-2026-07
# AIONIS_AUTHORITY_RECEIPT_HMAC_KEYS_JSON={"authority-2026-07":"replace-with-32-byte-or-longer-secret"}
# TRUST_PROXY=true
# TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Advanced: sandbox execution. Local process execution is development-only by
# default; production should use a hardened HTTPS remote executor.
# LITE_SANDBOX_PROFILE=local_process_echo
# SANDBOX_ENABLED=true
# SANDBOX_ADMIN_ONLY=true
# SANDBOX_EXECUTOR_MODE=local_process
# SANDBOX_ALLOWED_COMMANDS_JSON=["echo"]
# SANDBOX_EXECUTOR_WORKDIR=.tmp/sandbox
# SANDBOX_EXECUTOR_MODE=http_remote
# SANDBOX_REMOTE_EXECUTOR_URL=https://sandbox.example.internal/run
# SANDBOX_REMOTE_EXECUTOR_ALLOWED_HOSTS_JSON=["sandbox.example.internal"]

# Advanced: replay learning remains explicit opt-in and evidence-gated.
# REPLAY_LEARNING_PROJECTION_ENABLED=true
# REPLAY_LEARNING_PROJECTION_MODE=rule_and_episode
# REPLAY_REPAIR_REVIEW_AUTO_PROMOTE_DEFAULT=false
# REPLAY_REPAIR_REVIEW_GATE_REQUIRE_SHADOW_PASS=true

# Advanced: narrow profile-scoped admission activation. The global mode above
# remains the operator override.
# AIONIS_ADMISSION_CANDIDATE_POLICY_PROFILE_RULES_JSON=[{"profile_id":"worker-full-power","mode":"active","scope_prefixes":["my-project:"],"agent_roles":["worker"],"context_modes":["compact_agent"],"guide_modes":["full_power"]}]

# Only widen an unauthenticated Lite bind intentionally.
# AIONIS_LISTEN_HOST=0.0.0.0
# AIONIS_ALLOW_UNAUTHENTICATED_REMOTE=true
