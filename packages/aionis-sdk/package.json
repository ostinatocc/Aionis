{
  "name": "@aionis/sdk",
  "version": "0.1.8",
  "description": "TypeScript SDK facade for the Aionis state-adjudicated memory Runtime.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
