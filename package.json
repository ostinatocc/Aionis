{
  "name": "aionis-runtime-focused",
  "private": true,
  "version": "0.4.0-rc.1",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Local Runtime for model-independent Agent Execution Memory, verified continuity, adaptive experience, and controlled forgetting.",
  "homepage": "https://docs.aionis.work",
  "repository": {
    "type": "git",
    "url": "https://github.com/ostinatocc/Aionis.git"
  },
  "engines": {
    "node": ">=22.15.0 <23 || >=23.10.0"
  },
  "scripts": {
    "sdk:sync": "node scripts/sdk-source.mjs sync",
    "sdk:check": "node scripts/sdk-source.mjs check",
    "execution-skill:schema:write": "npx tsx scripts/generate-execution-skill-schema.ts --write",
    "execution-skill:schema:check": "npx tsx scripts/generate-execution-skill-schema.ts --check",
    "complexity:report": "node scripts/ci/runtime-complexity-budget.mjs",
    "complexity:check": "node scripts/ci/runtime-complexity-budget.mjs --check docs/architecture/runtime-complexity-budget.json",
    "typecheck": "npx tsc --noEmit -p tsconfig.json",
    "lite:build": "npm run -s typecheck",
    "lite:start": "bash scripts/start-lite.sh",
    "lite:smoke": "bash scripts/lite-smoke.sh",
    "build": "npm run -s typecheck",
    "core:build": "npm run -s typecheck"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fast-json-stable-stringify": "^2.1.0",
    "fastify": "^5.8.5",
    "zod": "^3.23.8"
  },
  "overrides": {
    "fast-uri": "3.1.2"
  },
  "devDependencies": {
    "@aionis/substrate": "^0.1.11",
    "@types/node": "^22.10.2",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "optionalDependencies": {
    "@zvec/zvec": "^0.5.0"
  }
}
