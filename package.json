{
  "name": "aionis-runtime-focused",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Focused Aionis local Runtime kernel for execution continuity, learning control, and controlled forgetting.",
  "homepage": "https://docs.aionis.work",
  "workspaces": [
    "packages/aionis-sdk",
    "packages/aionis-mcp",
    "packages/create-aionis"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ostinatocc/Aionis.git"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "typecheck": "npx tsc --noEmit",
    "sdk:source-sync": "node scripts/ci/check-sdk-source-sync.mjs",
    "lite:build": "npm run -s typecheck",
    "lite:start": "bash scripts/start-lite.sh",
    "lite:start:local-process": "LITE_SANDBOX_PROFILE=local_process_echo bash scripts/start-lite.sh",
    "lite:test": "node --test scripts/ci/*.mjs && npx tsx --test scripts/ci/*.ts",
    "lite:smoke": "bash scripts/lite-smoke.sh",
    "lite:smoke:local-process": "LITE_SANDBOX_PROFILE=local_process_echo bash scripts/lite-smoke.sh",
    "runtime:e2e:agent": "npx tsx scripts/e2e/runtime-agent-loop.ts",
    "runtime:e2e:agent-suite": "npx tsx scripts/e2e/runtime-agent-loop-suite.ts",
    "recall:eval": "npx tsx scripts/e2e/recall-engine-eval.ts",
    "admission:evaluate": "npx tsx scripts/e2e/admission-dataset-evaluator.ts",
    "admission:collect": "npx tsx scripts/e2e/admission-dataset-collector.ts",
    "admission:compare": "npx tsx scripts/e2e/admission-policy-comparison.ts",
    "test:focused": "npm run -s typecheck && npm run -s sdk:source-sync && npm run -s packages:build && npm run -s packages:test && npm run -s lite:test",
    "test:lite": "npm run -s lite:test",
    "smoke:lite": "npm run -s lite:smoke",
    "build": "npm run -s typecheck && npm run -s packages:build",
    "core:build": "npm run -s typecheck",
    "packages:build": "npm run -w @aionis/sdk -s build && npm run -w @aionis/mcp -s build && npm run -w @aionis/create -s build",
    "packages:test": "npm run -w @aionis/sdk -s test && npm run -w @aionis/mcp -s test && npm run -w @aionis/create -s test",
    "runtime:e2e:product-loop": "npx tsx scripts/e2e/product-four-api-loop.ts",
    "runtime:e2e:admission-dataset-export": "npx tsx scripts/e2e/admission-dataset-export-loop.ts",
    "runtime:quickstart:sdk": "npx tsx scripts/e2e/developer-sdk-quickstart.ts",
    "runtime:quickstart:http": "npx tsx scripts/e2e/developer-http-quickstart.ts",
    "runtime:quickstart:multi-agent": "npx tsx scripts/e2e/developer-multi-agent-quickstart.ts",
    "runtime:quickstart:memory-firewall": "npx tsx scripts/e2e/developer-memory-firewall-quickstart.ts",
    "runtime:quickstart:flight-recorder": "npx tsx scripts/e2e/developer-flight-recorder-quickstart.ts",
    "runtime:quickstart:claude-code-mcp": "npm run -s packages:build && npx tsx scripts/e2e/developer-claude-code-mcp-demo.ts",
    "runtime:smoke:external-packages": "npm run -s packages:build && npx tsx scripts/e2e/external-package-entrypoint-smoke.ts",
    "runtime:e2e:ordinary-memory": "npx tsx scripts/e2e/ordinary-memory-product-loop.ts",
    "runtime:e2e:golden-product-loop": "npx tsx scripts/e2e/golden-product-loop.ts",
    "runtime:e2e:judgment-calibration": "npx tsx scripts/e2e/judgment-calibration-product-loop.ts",
    "runtime:e2e:memory-firewall-ab": "npx tsx scripts/e2e/memory-firewall-ab-demo.ts",
    "runtime:e2e:flight-recorder-incident": "npx tsx scripts/e2e/flight-recorder-incident-demo.ts",
    "runtime:e2e:loop-engineering-profile": "npx tsx scripts/e2e/loop-engineering-profile.ts",
    "runtime:e2e:plan-as-memory-asset": "npx tsx scripts/e2e/plan-as-memory-asset-demo.ts",
    "runtime:e2e:managed-server-hybrid-recall": "npx tsx scripts/e2e/managed-server-hybrid-recall-loop.ts",
    "runtime:e2e:recall-source-governance": "npx tsx scripts/e2e/managed-server-hybrid-recall-loop.ts",
    "runtime:e2e:recall-troubleshooting": "npx tsx scripts/e2e/recall-engine-troubleshooting-demo.ts",
    "runtime:demo:first-value": "npx tsx scripts/e2e/first-value-demo.ts",
    "runtime:e2e:command-posture": "npm run -s packages:build && npx tsx scripts/e2e/command-posture-product-loop.ts",
    "runtime:e2e:single-agent-host-template": "npx tsx scripts/e2e/single-agent-host-template-loop.ts",
    "runtime:e2e:multi-agent": "npx tsx scripts/e2e/multi-agent-execution-memory-loop.ts",
    "runtime:e2e:multi-agent-host-template": "npx tsx scripts/e2e/multi-agent-host-template-loop.ts",
    "runtime:e2e:multi-agent-host-template-fresh": "npx tsx scripts/e2e/multi-agent-host-template-fresh-scope-loop.ts",
    "runtime:e2e:multi-agent-negative": "npx tsx scripts/e2e/multi-agent-execution-memory-negative-loop.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fast-json-stable-stringify": "^2.1.0",
    "fastify": "^5.8.5",
    "zod": "^3.23.8"
  },
  "overrides": {
    "fast-uri": "3.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3"
  }
}
