{
  "name": "aionis-runtime-focused",
  "private": true,
  "version": "1.0.0-alpha.1",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Aionis Continuation Runtime: governed execution continuity, evidence-bound learning, and controlled forgetting.",
  "homepage": "https://docs.aionis.work",
  "repository": {
    "type": "git",
    "url": "https://github.com/ostinatocc/Aionis.git"
  },
  "engines": {
    "node": ">=22.15.0 <23 || >=24.0.0 <25"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "authority:build": "node tools/build-continuation-runtime-v1-authority.mjs",
    "build": "node tools/clean-continuation-runtime-v1-build.mjs && tsc -p tsconfig.json && node tools/copy-continuation-runtime-v1-assets.mjs",
    "build:sdk": "npm run -s build && node packages/sdk/build.mjs",
    "check": "npm run -s complexity:test && npm run -s complexity:check && npm run -s schema:check && npm run -s typecheck && npm run -s test",
    "complexity:check": "node scripts/ci/runtime-complexity-budget.mjs --strict-no-legacy --check docs/architecture/runtime-complexity-budget.json",
    "complexity:test": "node --test scripts/ci/runtime-complexity-budget.test.mjs",
    "dev": "tsx src/runtime-v1/daemon-entry.ts",
    "dev:provision": "tsx src/runtime-v1/provisioning-entry.ts",
    "dev:worker": "tsx src/runtime-v1/worker-entry.ts",
    "schema:check": "tsx tools/generate-continuation-runtime-v1-manifest.ts --check",
    "start": "node dist/runtime-v1/daemon-entry.js",
    "start:provision": "node dist/runtime-v1/provisioning-entry.js",
    "start:worker": "node dist/runtime-v1/worker-entry.js",
    "test": "node --import tsx --test --test-concurrency=1 scripts/ci/lite-continuation-*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json"
  },
  "dependencies": {
    "fastify": "^5.8.5",
    "zod": "^3.23.8"
  },
  "overrides": {
    "fast-uri": "3.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3"
  }
}
