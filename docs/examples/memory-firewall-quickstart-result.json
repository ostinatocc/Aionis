{
  "contract_version": "aionis_memory_firewall_quickstart_result_v1",
  "run_id": "memory-firewall-example",
  "runtime": {
    "mode": "spawned",
    "base_url": "http://127.0.0.1:3001",
    "embedding_provider": "minimax"
  },
  "integration_path": {
    "sdk_client": "createAionisClient",
    "product_loop": "external candidates -> governMemory(mode=firewall) -> agent_context + audit records",
    "route": "POST /v1/memory/govern"
  },
  "external_memory_governance": {
    "candidate_count": 6,
    "use_now_memory_ids": ["mem0:current-route"],
    "inspect_before_use_memory_ids": ["logs:unknown-note"],
    "do_not_use_memory_ids": ["zep:failed-route", "vector:stale-note", "markdown:contested-note"],
    "rehydrate_memory_ids": ["archive:raw-evidence"]
  },
  "memory_firewall": {
    "contract_version": "aionis_memory_firewall_summary_v1",
    "direct_use_count": 1,
    "inspect_count": 1,
    "blocked_count": 3,
    "rehydrate_count": 1,
    "unsafe_direct_use_count": 0,
    "runtime_mutation": false,
    "agent_prompt_included": false
  },
  "operator_audit": {
    "memory_use_receipt_visible": true,
    "memory_admission_record_visible": true,
    "memory_write_omitted": true
  },
  "checks": {
    "current_memory_direct_use": true,
    "failed_memory_blocked": true,
    "stale_memory_blocked": true,
    "contested_memory_blocked": true,
    "unknown_memory_inspect_first": true,
    "rehydrate_memory_pointer_only": true,
    "unsafe_direct_use_zero": true,
    "no_runtime_mutation": true,
    "prompt_boundary_preserved": true
  }
}
