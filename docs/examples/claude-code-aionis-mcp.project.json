{
  "mcpServers": {
    "aionis": {
      "command": "npx",
      "args": [
        "-y",
        "@aionis/mcp@latest",
        "--base-url",
        "${AIONIS_BASE_URL:-http://127.0.0.1:3001}",
        "--scope",
        "${AIONIS_SCOPE:-claude-code-demo}"
      ],
      "env": {
        "AIONIS_TENANT_ID": "${AIONIS_TENANT_ID:-default}",
        "AIONIS_GUIDE_MODE": "${AIONIS_GUIDE_MODE:-full_power}"
      }
    }
  }
}
