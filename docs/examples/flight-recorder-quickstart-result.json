{
  "contract_version": "aionis_flight_recorder_quickstart_result_v1",
  "run_id": "flight-recorder-example",
  "runtime": {
    "mode": "spawned",
    "base_url": "http://127.0.0.1:3001",
    "embedding_provider": "minimax"
  },
  "integration_path": {
    "sdk_client": "createAionisClient",
    "product_loop": "governMemory -> agent action -> flightRecorder",
    "route": "POST /v1/audit/flight-recorder"
  },
  "agent_view": {
    "prompt_text_included": false,
    "use_now_memory_ids": ["mem0:current-route"],
    "do_not_use_memory_ids": ["zep:failed-route"],
    "rehydrate_memory_ids": ["archive:raw-evidence"]
  },
  "incident_replay": {
    "blocked_or_suppressed_count": 1,
    "attribution_present": true,
    "outcome": "positive",
    "used_memory_ids": ["mem0:current-route"],
    "runtime_mutation": false,
    "agent_prompt_included": false
  },
  "replay_sources": {
    "has_agent_context": true,
    "has_memory_use_receipt": true,
    "has_memory_admission_record": true,
    "has_feedback_result": true
  },
  "checks": {
    "direct_use_replayed": true,
    "blocked_memory_replayed": true,
    "rehydrate_pointer_replayed": true,
    "feedback_attribution_replayed": true,
    "prompt_payload_excluded": true,
    "no_runtime_mutation": true
  }
}
