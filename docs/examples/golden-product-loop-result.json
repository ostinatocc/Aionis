    "failed_branch_isolated": {
      "branch_isolation": "pass",
      "reviewer_next_action": "continue_passed_branch",
      "reviewer_avoided_failed_branch": true,
      "proof": "Failed branch remains visible as do_not_use/counter-evidence and does not leak into use_now."
    },
    "operator_explains_memory": {
      "memory_use_receipt_visible": true,
      "feedback_attribution_present": true,
      "trace_to_procedure_present": true,
      "trace_to_procedure_status": "candidate_only",
      "trace_to_procedure_source_surfaces": [
        "execution_tree",
        "workflow_projection",
        "execution_contract"
      ],
      "proof": "Operator snapshot exposes read-only memory receipt, feedback attribution, effect, and procedure-readiness state."
    }
  },
  "golden_metrics": {
    "before_actionable_history_used": false,
    "reviewer_actionable_history_used": true,
    "reviewer_use_now_count": 3,
    "execution_do_not_use_count": 1,
    "feedback_changed_count": 1,
    "measure_history_impact": "positive",
    "operator_snapshot_effect_impact": "positive"
  },
  "memory_ids": {
    "planner_memory_id": "mem_planner_example",
