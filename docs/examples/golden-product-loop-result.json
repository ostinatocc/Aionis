    "passed_memory_id": "mem_passed_example",
    "reviewer_memory_id": "mem_reviewer_example"
  },
  "checks": {
    "real_runtime_loop": true,
    "observe_guide_agent_feedback_measure_snapshot": true,
    "starts_without_actionable_history": true,
    "later_uses_actionable_execution_memory": true,
    "reviewer_continues_passed_branch": true,
    "reviewer_avoids_failed_branch": true,
    "operator_snapshot_explains_use": true,
    "trace_to_procedure_visible": true
  }
